{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "AeroCore Apex — DTC WooCommerce",
        "blogdescription": "Lossless Planar Magnetic Wireless Headphones"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/ShehabGamal/aerocore-apex",
        "ref": "HEAD",
        "path": "wp-content/themes/aerocore-apex"
      },
      "options": {
        "activate": true,
        "targetFolderName": "aerocore-apex"
      }
    }
  ]
}
